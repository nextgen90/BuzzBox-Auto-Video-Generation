*.swp

# Project-specific paths containing generated data or secrets
logs/*
!logs/.gitkeep

outputs/*
!outputs/.gitkeep

storage/*
!storage/.gitkeep

uploads/*
!uploads/.gitkeep

# Exclude LTX-Video documentation static assets to avoid Git LFS errors
LTX-Video/docs/
